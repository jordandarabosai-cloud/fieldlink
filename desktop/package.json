{
  "name": "fieldlink-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "lint": "eslint .",
    "cap:build": "vite build && npx cap sync",
    "dist:win": "npm run build && electron-packager . FieldLink --platform=win32 --arch=x64 --out=release --overwrite",
    "dist:win:installer": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "modbus-serial": "^8.0.25",
    "net-snmp": "^3.29.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "@electron/packager": "^20.3.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "ai.jordandarabos.fieldlink",
    "productName": "FieldLink",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/serialport/**/*",
      "node_modules/@serialport/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
